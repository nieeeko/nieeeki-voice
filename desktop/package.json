{
  "name": "nieeeki-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "nieeeki als Desktop-Client: ungedrosseltes Gespraech, Stimmen-Rand ueber allen Monitoren, Autostart",
  "author": "nieeeko",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.nieeeko.nieeeki",
    "productName": "nieeeki",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "overlay.js",
      "overlay-preload.js"
    ],
    "extraResources": [
      {
        "from": "icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "nieeeki",
      "runAfterFinish": true,
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "nieeeki-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.17.0"
  }
}
