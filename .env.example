# nieeeki-voice: Vorlage fuer lokale Schluessel.
# Kopieren nach ".env" (im Hauptordner oder in voice-core\) und Werte eintragen.
# Die .env wird NIE committet (steht in .gitignore).

# --- Pflicht fuer den ersten Test ---
SONIOX_API_KEY=
ANTHROPIC_API_KEY=

# --- Optional (Standardwerte passen) ---
CLAUDE_MODEL_FAST=claude-haiku-5-5
SONIOX_STT_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_TTS_URL=wss://tts-rt.soniox.com/tts-websocket
SONIOX_VOICE=Lena
# SONIOX_SPEED=1.1
# SONIOX_REDUCE_SILENCE=1
MIN_INTERRUPT_WORDS=2

# --- Gedaechtnis (spaeter; leer lassen = Gedaechtnis aus) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NIEEEKI_DB_SCHEMA=nieeeki_voice_dev
NIEEEKI_OWNER_ID=
VOYAGE_API_KEY=

# --- Direkt-Zugaenge fuer nieeeki (voice-core/cloud.py) ---
# GitHub laeuft ueber die angemeldete gh-Kommandozeile (gh auth login), kein Token noetig.
# Vercel: Account Settings -> Tokens. Optional die Team-ID, sonst gilt das Standard-Team des Tokens.
VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# Supabase: supabase.com -> Account -> Access Tokens (Management-API: Projekte, Tabellen, SQL)
SUPABASE_ACCESS_TOKEN=
