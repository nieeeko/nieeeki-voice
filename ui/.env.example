# Oeffentliche Werte (Publishable Key ist fuer den Browser gedacht; Zugriff regelt RLS)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_NIEEEKI_DB_SCHEMA=nieeeki_voice_dev
# Adresse des Voice-Core (lokal oder Runpod)
NEXT_PUBLIC_VOICE_CORE_URL=http://localhost:7860
# Content-Security-Policy (src/lib/csp.ts), nur im Produktions-Build; in der Entwicklung immer aus.
# beobachten (Standard): strenge Policy nur als Report-Only, Meldungen in den Vercel-Logs ("csp-report")
# streng: strenge Policy scharf (erst nach einem Live-Lauf ohne Meldungen)   aus: nur der Grundschutz
# NIEEEKI_CSP=beobachten
