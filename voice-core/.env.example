SONIOX_API_KEY=
ANTHROPIC_API_KEY=
# Sprachmodell fuer das Gespraech: Haiku (guenstig, schnell). Opus spaeter fuer Hintergrund-Tasks
CLAUDE_MODEL_FAST=claude-haiku-5-5
SONIOX_STT_URL=wss://stt-rt.eu.soniox.com/transcribe-websocket
SONIOX_TTS_URL=wss://tts-rt.soniox.com/tts-websocket
# Bibliotheksstimme oder UUID der geklonten Stimme
SONIOX_VOICE=Lena
# Tempo 0.7 bis 1.3 und kuerzere Pausen zwischen Woertern (1/0). Ohne Eintrag: Soniox-Standard.
# SONIOX_SPEED=1.1
# SONIOX_REDUCE_SILENCE=1
# Fachbegriffe fuer die Spracherkennung (kommagetrennt). Ohne Eintrag gilt die Liste in bot.py,
# ein leerer Wert schaltet sie ab.
# SONIOX_TERMS=nieeeki, öffne mal, Opera, WhatsApp, VS Code
# Live-Bildschirm in der Oberflaeche (screen_stream.py): Bilder pro Sekunde und Breite (16:9).
# SCREEN_STREAM_FPS=4
# SCREEN_STREAM_WIDTH=1280
# Weckwort "nieeeki" (wake.py mit models/nieeeki.onnx, startet die Desktop-App): Schwelle 0..1
# (hoeher = seltener Fehlalarm, aber oefter ueberhoert) und die kurze Antwort, wenn das Gespraech
# per Weckwort beginnt.
# NIEEEKI_WAKE_THRESHOLD=0.5
# NIEEEKI_WAKE_GREETING=Ja?
# Stimmabdruck (voice_gate.py): nur Nikolajs Stimme darf Auftraege und PC-Aktionen ausloesen
# (Uhrzeit, Websuche und Canvas darf jede Stimme). Einlernen per "Stimme einlernen" in der Oberflaeche.
# aus | beobachten (Standard: misst, meldet und protokolliert, sperrt nichts) | streng
# NIEEEKI_VOICE_CHECK=beobachten
# Aehnlichkeit mit dem Abdruck (0..1): ab OWNER_MIN Nikolaj, bis STRANGER_MAX fremd, dazwischen unklar
# (sperrt im Modus streng). Unter MIN_SECS reiner Sprache ("Ja") gilt das Ergebnis davor, hoechstens
# TRUST_SECS nach der letzten sicheren Erkennung.
# NIEEEKI_VOICE_OWNER_MIN=0.5
# NIEEEKI_VOICE_STRANGER_MAX=0.3
# NIEEEKI_VOICE_MIN_SECS=1.0
# NIEEEKI_VOICE_TRUST_SECS=120
MIN_INTERRUPT_WORDS=2
# Innehalten: ein einzelnes Wort von Nikolaj, waehrend nieeeki spricht -> sie haelt an der Wortgrenze
# inne und spricht dort weiter, wenn nach WEITER Sekunden nichts kam (hoechstens MAX). 0 = aus.
# PAUSE_ON_INTERJECTION=1
# INTERJECTION_RESUME_SECS=0.7
# INTERJECTION_MAX_PAUSE_SECS=2.5
# Fuellwoerter: "Moment.", wenn ein Werkzeug laeuft und sie noch nichts gesagt hat (0 = aus), und
# "Mhm", wenn Claude einen Satz fuer unfertig haelt (Standard aus). Aufnahmen: voice-core/.cache/.
# FILLER_WORDS=1
# FILLER_AFTER_SECS=0.4
# BACKCHANNEL_MHM=0
# Von welchen Seiten Sitzungen starten duerfen (kommagetrennt). Ohne Eintrag: localhost:3000,
# 127.0.0.1:3000 und https://nieeeki.nieeeko.com (siehe bot.py). Zusaetzlich braucht jede Anfrage
# Nikolajs Supabase-Login mit zweitem Faktor (auth_gate.py, nutzt SUPABASE_URL, NIEEEKI_OWNER_ID
# und SUPABASE_PUBLISHABLE_KEY).
# PIPECAT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://nieeeki.nieeeko.com
# Zusaetzlich die Vercel-Vorschauen des Projekts (nur mit Vercel-Anmeldung erreichbar, auth_gate.py).
# Leer = keine Vorschauen.
# PIPECAT_ALLOWED_ORIGIN_REGEX=https://nieeeki-voice-[a-z0-9-]+-nieeeko\.vercel\.app

# Supabase (service_role NUR hier, nie im Browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NIEEEKI_DB_SCHEMA=nieeeki_voice_dev
NIEEEKI_OWNER_ID=
# Embeddings fuer den Lernspeicher (optional)
VOYAGE_API_KEY=

# Weg B (plans/online-ohne-tailscale.md): Offers aus Supabase abholen statt HTTP anzunehmen, damit das Handy ohne
# Tailscale-App kommt. Aus, solange nicht 1. Braucht SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, NIEEEKI_OWNER_ID und die
# Migration 0002 im Schema. Der Voice-Core fragt nur ausgehend nach (alle 2 s), am Laptop lauscht nichts.
# NIEEEKI_RENDEZVOUS=1
# Ohne Geraetebindung (Plan, Schritt 6, noch nicht gebaut) startet es nur mit dieser ausdruecklichen Zustimmung; dann
# reicht ein gestohlenes Supabase-Token fuer eine Sitzung (Tailscale schuetzt nur den direkten Weg).
# NIEEEKI_RENDEZVOUS_UNBOUND=1
# STUN/TURN fuer den Laptop als JSON-Liste (nichts gesetzt = nur lokale Adressen). Zugangsdaten gehoeren nur hierher.
# NIEEEKI_ICE_SERVERS=[{"urls": ["stun:stun.example.org:3478"]}]
